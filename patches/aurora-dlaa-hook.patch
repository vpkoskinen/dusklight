+/// A texture (and its view) to blit to the swapchain in place of the scene.
+struct PostProcessTarget {
+  wgpu::Texture texture;
+  wgpu::TextureView view;
+  wgpu::TextureFormat format = wgpu::TextureFormat::Undefined;
+  uint32_t width = 0;
+  uint32_t height = 0;
+};
+
+/// Invoked on the render worker immediately before the present blit, after the
+/// scene's command encoder has been finished and submitted. The implementation
+/// is responsible for making the scene inputs GPU-ready (e.g. vkDeviceWaitIdle
+/// via the Dawn device) before reading them. Both the textures and their views
+/// are passed so a backend bridge can obtain the underlying native images
+/// (e.g. `VkImage`) as well as the Dawn views. Return a target to present, or an
+/// empty target (`view` == nullptr) to present the scene unmodified.
+using ScenePostProcessFn = PostProcessTarget (*)(void* userdata, const wgpu::Texture& sceneColorTexture,
+                                                 const wgpu::TextureView& sceneColor,
+                                                 const wgpu::Texture& sceneDepthTexture,
+                                                 const wgpu::TextureView& sceneDepth, uint32_t width, uint32_t height);
+
+/// Registers (or clears, with a null fn) a hook that may replace the scene when
+/// it is blitted to the swapchain. Set from the game thread; read on the render
+/// worker. Pass nullptr to restore the default present path.
+void set_scene_post_process(ScenePostProcessFn fn, void* userdata);
+
+/// Sets the sub-pixel projection jitter, in render-pixel units, applied to
+/// perspective projections on subsequently recorded draws. Set once per frame
+/// by the renderer; (0, 0) disables jitter (the default). The value is in the
+/// same render-pixel space as a temporal upscaler's jitter input (e.g. NGX
+/// `InJitterOffsetX/Y`) and is intended to be fed both from the same source.
+/// Orthographic projections (HUD/UI, shadow maps) are never jittered. Set from
+/// the game thread; read on the render worker.
+void set_projection_jitter(float x, float y);
+
 /// Append transient data to the shared per-frame streaming buffers. Returned

+// Registry of extensions and options requested by the application. Requests are expected to be
+// made before the instance/device is created, and are read (not mutated) during creation.
+std::mutex& GetRequestRegistryMutex() {
+    static std::mutex mutex;
+    return mutex;
+}
+
+std::vector<std::string>& GetInstanceExtensionRegistry() {
+    static std::vector<std::string> extensions;
+    return extensions;
+}
+
+std::vector<std::string>& GetDeviceExtensionRegistry() {
+    static std::vector<std::string> extensions;
+    return extensions;
+}
+
+bool& GetAppVkQueueRegistry() {
+    static bool requested = false;
+    return requested;
+}
+
+void AddExtensionNames(std::vector<std::string>& registry,
+                       const char* const* names,
+                       uint32_t count) {
+    if (names == nullptr || count == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(GetRequestRegistryMutex());
+    for (uint32_t i = 0; i < count; ++i) {
+        if (names[i] == nullptr || names[i][0] == '\0') {
+            continue;
+        }
+        std::string name(names[i]);
+        if (std::find(registry.begin(), registry.end(), name) == registry.end()) {
+            registry.push_back(std::move(name));
+        }
+    }
+}
+

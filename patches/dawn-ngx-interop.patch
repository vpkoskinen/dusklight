+VkPhysicalDevice GetVkPhysicalDevice(WGPUDevice device) {
+    Device* backendDevice = ToBackend(FromAPI(device));
+    return static_cast<PhysicalDevice*>(backendDevice->GetPhysicalDevice())->GetVkPhysicalDevice();
+}
+
+VkImage GetVkImage(WGPUTexture texture) {
+    Texture* backendTexture = ToBackend(FromAPI(texture));
+    return backendTexture != nullptr ? backendTexture->GetHandle() : VK_NULL_HANDLE;
+}
+
+VkImageView GetVkImageView(WGPUTextureView view) {
+    TextureView* backendView = ToBackend(FromAPI(view));
+    return backendView != nullptr ? backendView->GetHandle() : VK_NULL_HANDLE;
+}
+
+uint32_t GetQueueFamilyIndex(WGPUDevice device) {
+    Device* backendDevice = ToBackend(FromAPI(device));
+    return backendDevice->GetGraphicsQueueFamily();
+}
+
+PFN_vkVoidFunction GetDeviceProcAddr(WGPUDevice device, const char* pName) {
+    Device* backendDevice = ToBackend(FromAPI(device));
+    return backendDevice->fn.GetDeviceProcAddr(backendDevice->GetVkDevice(), pName);
+}
+
+VkQueue GetAppVkQueue(WGPUDevice device) {
+    Device* backendDevice = ToBackend(FromAPI(device));
+    VkQueue queue = VK_NULL_HANDLE;
+    backendDevice->fn.GetDeviceQueue(backendDevice->GetVkDevice(),
+                                     backendDevice->GetGraphicsQueueFamily(), 1, &queue);
+    return queue;
+}
+
+void RequestAdditionalInstanceExtensions(const char* const* names, uint32_t count) {
+    AddExtensionNames(GetInstanceExtensionRegistry(), names, count);
+}
+
+void RequestAdditionalDeviceExtensions(const char* const* names, uint32_t count) {
+    AddExtensionNames(GetDeviceExtensionRegistry(), names, count);
+}
+
+void RequestAppVkQueue(bool enable) {
+    std::lock_guard<std::mutex> lock(GetRequestRegistryMutex());
+    GetAppVkQueueRegistry() = enable;
+}
+
+const std::vector<std::string>& GetRequestedInstanceExtensions() {
+    return GetInstanceExtensionRegistry();
+}
+
+const std::vector<std::string>& GetRequestedDeviceExtensions() {
+    return GetDeviceExtensionRegistry();
+}
+
+bool IsAppVkQueueRequested() {
+    return GetAppVkQueueRegistry();
+}
